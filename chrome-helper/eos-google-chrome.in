#!/bin/bash

ABSOLUTE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

if ! malcontent-client --quiet check-app-filter --no-interactive ${ABSOLUTE_PATH} ||
   ! malcontent-client --quiet check-app-filter --no-interactive "x-scheme-handler/http"; then
  echo "error: $ABSOLUTE_PATH is blocked for the current user" >&2
  exit 1
fi

if [ "$(/usr/bin/flatpak info -o com.google.Chrome//stable)" == "flathub" ]; then
  chrome_cmd="/usr/bin/flatpak run com.google.Chrome//stable"
else
  chrome_cmd="/usr/share/eos-google-chrome-helper/eos-google-chrome.py"
fi

exec $chrome_cmd "$@"
